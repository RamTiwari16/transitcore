<Project>
  <!--
    Produces one self-contained, single-file win-x64 .exe with the .NET
    runtime bundled in - nothing else needs installing on the target
    machine except SQL Server LocalDB (see README.md's "Standalone build"
    section for the one-time LocalDB install + the full publish steps).

    Usage: build the Angular app first (npm run build, in TransitCore.Web),
    then from TransitCore.Api:
      dotnet publish -c Release -p:PublishProfile=win-x64-standalone
  -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishDir>bin\Release\net10.0\win-x64\publish\</PublishDir>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>
</Project>
